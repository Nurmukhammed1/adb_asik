{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Mongo": {
    "ConnectionString": "mongodb://localhost:27017/?directConnection=true",
    "Database": "cinematch"
  },
  "Redis": {
    "ConnectionString": "127.0.0.1:6379"
  },
  "Jwt": {
    "Issuer": "cinematch",
    "Audience": "cinematch",
    "LifetimeMinutes": 60
  },
  "Recommender": {
    "NeighborsPerMovie": 50,
    "MinCommonRaters": 5,
    "Shrinkage": 50,
    "MinRatingsForPersonal": 5,
    "PredictionDamping": 1,
    "RankBy": "Evidence",
    "PopularPriorWeight": 50,
    "NightlyRebuildHour": 3,
    "BuildOnStartupIfEmpty": true
  }
}
