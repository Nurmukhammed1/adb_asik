{
  "info": {
    "name": "CineMatch API",
    "description": "Requests for every CineMatch endpoint, in an order that works from top to bottom.\n\n1. Start the API (see the README) and run **Auth > Register**.\n2. For the Admin folder, set the collection variable `adminPassword` and run **Auth > Login as admin**.\n\nTokens and ids are saved into collection variables automatically.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5196",
      "description": "Where the API runs."
    },
    {
      "key": "movieId",
      "value": "1",
      "description": "The movie used by the detail and interaction requests (1 = Toy Story)."
    },
    {
      "key": "adminPassword",
      "value": "",
      "description": "Fill in before 'Login as admin'. It is the importer's demo password."
    },
    {
      "key": "newUsername",
      "value": "",
      "description": "Set automatically by 'Register'."
    },
    {
      "key": "newPassword",
      "value": "",
      "description": "Set automatically by 'Register'."
    },
    {
      "key": "token",
      "value": "",
      "description": "Set automatically by 'Register' and 'Login'."
    },
    {
      "key": "adminToken",
      "value": "",
      "description": "Set automatically by 'Login as admin'."
    },
    {
      "key": "userId",
      "value": "",
      "description": "Set automatically by 'Register'."
    },
    {
      "key": "newMovieId",
      "value": "",
      "description": "Set automatically by 'Create movie'."
    }
  ],
  "item": [
    {
      "name": "Health",
      "description": "Is the API running?",
      "item": [
        {
          "name": "Health check",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns {\"status\":\"ok\"} when the API can reach MongoDB.",
            "auth": {
              "type": "noauth"
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Auth",
      "description": "Run 'Register' first: it creates a fresh account and saves its token for all later requests.",
      "item": [
        {
          "name": "Register (saves token)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// A fresh account on every run.",
                  "pm.collectionVariables.set('newUsername', 'postman_' + Date.now());",
                  "pm.collectionVariables.set('newPassword', 'Pm-' + pm.variables.replaceIn('{{$randomAlphaNumeric}}{{$guid}}'));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.token);",
                  "pm.collectionVariables.set('userId', body.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Creates an account. A unique username and a password are generated before the request.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"email\": \"{{newUsername}}@example.com\",\n  \"password\": \"{{newPassword}}\",\n  \"displayName\": \"Postman Tester\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Logs in with a username or email. To use an imported MovieLens account instead, send user1 ... user610 with the demo password.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{newUsername}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Login as admin (saves adminToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Set the collection variable adminPassword first. See it with: dotnet user-secrets list --project backend/tools/CineMatch.Importer",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
